# GapMind environment overrides.
# Stable non-secret defaults are in config/gapmind.yaml.
# Copy this file to .env, then fill in the credentials you actually use.
# A local .env.local file is also supported and is ignored by git.

# Required for the main AI and retrieval flows.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Optional: improves Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Required when APP_ENV is staging or production.
AUTH_SESSION_SECRET=

# Optional deployment overrides. Leave unset for local defaults.
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# REDIS_URL=redis://host:6379/0
# CELERY_BROKER_URL=redis://host:6379/1
# CELERY_RESULT_BACKEND=redis://host:6379/2
# CORS_ORIGINS=https://your-frontend.example.com
# VITE_API_BASE_URL=https://your-api.example.com/api/v1

# Optional backup/remote providers. Configure all fields in a group to enable.
# DEEPSEEK_BACKUP_API_KEY=
# DEEPSEEK_BACKUP_BASE_URL=
# DEEPSEEK_BACKUP_MODEL=
# GAP_EXTRACTOR_REMOTE_ENABLED=true
# GAP_EXTRACTOR_REMOTE_BASE_URL=
# GAP_EXTRACTOR_REMOTE_API_KEY=
# GAP_EXTRACTOR_REMOTE_MODEL=
