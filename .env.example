# ====================================================================
# GapMind environment variables (single source of truth, repo root)
#   - backend (uvicorn/celery/alembic): loaded by app.core.config
#   - infra (docker compose): docker compose --env-file ../.env up -d
#   - frontend (vite): VITE_* vars only, via envDir in vite.config.ts
# Copy to ".env" and fill in real keys.
# ====================================================================

# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_STORAGE_DIR=./storage
WORKSPACE_STORAGE_QUOTA_BYTES=524288000

# ---- Delivery authentication ----
# Development permits the local X-User-ID fallback. Staging/production use
# invitation-created accounts and HttpOnly server sessions. AUTH_TOKENS is a
# temporary compatibility mechanism and should be empty in normal operation.
AUTH_REQUIRED=false
AUTH_TOKENS=
AUTH_SESSION_SECRET=change-this-to-a-long-random-secret
AUTH_COOKIE_NAME=gm_session
AUTH_CSRF_COOKIE_NAME=gm_csrf
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_HOURS=12
AUTH_SESSION_MAX_DAYS=30
AUTH_INVITE_TTL_HOURS=72
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# Passwords must be non-empty; there is no character-count minimum. This byte
# ceiling prevents pathological request sizes while allowing long passphrases.
# 0 means no product-level password length limit; set a positive defensive
# request ceiling only if required by the deployment threat model.
AUTH_MAX_PASSWORD_BYTES=0
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300

# ---- PostgreSQL ----
POSTGRES_USER=gapmind
POSTGRES_PASSWORD=gapmind
POSTGRES_DB=gapmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gapmind:gapmind@localhost:5432/gapmind

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=gapmind_

# ---- LLM (Deepseek) ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional demo-day fuse: any OpenAI-compatible endpoint as backup; enabled
# only when all three fields below are set
DEEPSEEK_BACKUP_API_KEY=
DEEPSEEK_BACKUP_BASE_URL=
DEEPSEEK_BACKUP_MODEL=

# ---- Fine-tuned research-gap extractor (Ollama, zf model) ----
# Native backend: 127.0.0.1 (SSH tunnel). Docker backend: host.docker.internal.
GAP_EXTRACTOR_BASE_URL=http://127.0.0.1:11434
GAP_EXTRACTOR_MODEL=research-dataset-qwen3:run7-q8-templatefix
GAP_EXTRACTOR_MODEL_DIGEST=
GAP_EXTRACTOR_TIMEOUT_SECONDS=600
GAP_EXTRACTOR_REPAIR_ATTEMPTS=2
GAP_EXTRACTOR_NUM_CTX=32768
GAP_EXTRACTOR_NUM_PREDICT=4096
GAP_EXTRACTOR_TEMPERATURE=0.01
GAP_EXTRACTOR_TOP_P=1
GAP_EXTRACTOR_REPEAT_PENALTY=1.05
GAP_EXTRACTOR_SEED=42
# Optional remote structured-output backup. Disabled by default; when enabled
# and fully configured, eligible local failures automatically send paper Markdown
# to this endpoint. No per-request consent field is used.
GAP_EXTRACTOR_REMOTE_ENABLED=false
GAP_EXTRACTOR_REMOTE_BASE_URL=
GAP_EXTRACTOR_REMOTE_API_KEY=
GAP_EXTRACTOR_REMOTE_MODEL=
GAP_EXTRACTOR_REMOTE_MAX_TOKENS=4096

# ---- Chat (workspace RAG) ----
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_HISTORY_CHAR_LIMIT=60000
CHAT_MAX_INPUT_CHARS=12000
CHAT_RAG_TOP_K=6
CHAT_RAG_MAX_CONTEXT_CHARS=18000
EVIDENCE_FRESHNESS_MAX_AGE_DAYS=30

# ---- Controlled workspace agents ----
AGENT_RAG_TOP_K=10
AGENT_CODE_MAX_FILES=30
AGENT_CODE_MAX_CHARS=300000

# ---- Embedding (SiliconFlow, BGE-m3) ----
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ---- Semantic Scholar ----
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

# ---- CORS (frontend origin) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend (vite only loads VITE_* vars; fallback matches dev proxy) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Legacy compatibility only; prefer the HttpOnly session cookie.
VITE_API_TOKEN=
