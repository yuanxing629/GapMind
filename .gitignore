# ================================================================
# GapMind .gitignore
# ================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.installed.cfg
*.egg

# ---- Virtual env ----
.venv/
venv/
env/
ENV/

# ---- IDE / Editor ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Env / secrets (NEVER commit) ----
.env
.env.local
.env.*.local
*.pem
*.key
backend/.env
frontend/.env
infra/.env

# ---- Logs ----
*.log
logs/

# ---- Database ----
*.sqlite3
*.db
*.db-journal

# ---- Build / cache artifacts ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
coverage/

# ---- Node / Frontend ----
node_modules/
dist/
.vite/
*.local

# ---- OpenAPI codegen intermediates ----
# Run `npm run gen:api` to regenerate `frontend/src/api/types/api.gen.ts`
# (the committed source of truth for frontend types).
# - backend/openapi.json: exported by `python scripts/export_openapi.py`
# - frontend/openapi.json: working copy consumed by openapi-typescript
backend/openapi.json
frontend/openapi.json

# ---- Retrieval Gate evaluation outputs ----
# Every run of `evaluation/retrieval/run_eval.py` writes a JSON report here;
# they are evidence artifacts, not source, and are not committed.
evaluation/retrieval/reports/
evaluation/retrieval/eval_report.json

# ---- Workspace Chat QA evaluation outputs ----
# Offline Chat QA reports may contain real paper excerpts and local message ids.
evaluation/chat/reports/

# ---- Stage 3 external novelty Gate outputs ----
# Every run of `evaluation/external/verify_external_gate.py` writes a report here.
evaluation/external/reports/

# ---- Artifact storage (user-uploaded PDFs, parsed text, chunks) ----
# These contain real paper content and should never be in git.
# Ignore directory CONTENTS (not the dirs themselves) so we can keep
# README.md files as documentation.
backend/storage/*
!backend/storage/README.md
backend/data/*
!backend/data/README.md
storage/*
artifacts/*
uploads/*

# ---- Milvus / Docker volumes ----
volumes/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Claude Code (private session/config) ----
.claude/

# ---- Misc tool caches ----
.cache/
.npm-cache/

# ---- Temporary files ----
# User-side temp dirs for test PDFs, scratch data, etc.
backend/temp_storage/
backend/_tmp_*.py
backend/scripts/_tmp_*.py
backend/.test-storage-run/
backend/.pytest-temp-run/
.run/

# ---- Internal-only docs (not for teammates) ----
/CLAUDE.md
/AGENTS.md


zwx_work.md


/data/
/submission/
/docs/
